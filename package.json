{
  "name": "prism",
  "productName": "PRism",
  "version": "0.0.1",
  "description": "Review GitHub pull requests with AI agents.",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://github.com/Adzouz/prism",
  "repository": "github:Adzouz/prism",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint --deny-warnings src scripts *.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:denylist": "node scripts/check-denylist.mjs",
    "db:generate": "drizzle-kit generate",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:mac:dev": "pnpm build && electron-builder --mac dir --arm64 -c.mac.notarize=false -c.mac.identity=-",
    "install:app": "scripts/install-app.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.3.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.69.0",
    "oxlint": "^1.91.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zustand": "5.0.16"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
