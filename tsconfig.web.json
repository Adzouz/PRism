{
  "extends": "./tsconfig.base.json",
  "include": ["src/renderer/src/**/*", "src/preload/*.d.ts", "src/shared/**/*"],
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@/*": ["./src/renderer/src/*"]
    }
  }
}
